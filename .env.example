# Copy to .env.local and fill in. Never commit .env or .env.local.

# ── Tickets enquiry form ───────────────────────────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. The festival's own inbox.
CONTACT_EMAIL_TO=info@siargaofoodfest.com

# Verified sender on your Resend domain. Must be a domain you've verified with Resend,
# not a gmail.com address, or sending is rejected.
CONTACT_EMAIL_FROM=tickets@siargaofoodfest.com

# WhatsApp number in wa.me format: country code + number, digits only.
# No +, no spaces, no dashes. Philippine mobile 0917 123 4567 becomes 639171234567.
# Leave blank and the WhatsApp button simply doesn't render.
NEXT_PUBLIC_WHATSAPP_NUMBER=
