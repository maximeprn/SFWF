# Copy to .env.local and fill in. Never commit .env or .env.local.

# ── Tickets enquiry form ───────────────────────────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. The festival's own inbox.
CONTACT_EMAIL_TO=info@siargaofoodfest.com

# Verified sender on your Resend domain. Must be a domain you've verified with Resend,
# not a gmail.com address, or sending is rejected.
CONTACT_EMAIL_FROM=tickets@siargaofoodfest.com

# WhatsApp number in wa.me format: country code + number, digits only.
# No +, no spaces, no dashes. Philippine mobile 0917 123 4567 becomes 639171234567.
# Leave blank and the WhatsApp button simply doesn't render.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Analytics ──────────────────────────────────────────────────────────────
# GA4 measurement ID for this site's data stream — Admin → Data streams → Web.
# Format: G-XXXXXXXXXX. Set it in Vercel's Production environment only; leave it
# blank locally and on previews and no tag loads at all.
NEXT_PUBLIC_GA_ID=

# ── Video hosting (Mux) ────────────────────────────────────────────────────
# Access token with "Mux Video" read+write, from
# https://dashboard.mux.com/settings/access-tokens
# Only needed to run `npm run mux:upload`. The site itself needs no Mux key —
# playback IDs are public and live in the committed source.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
